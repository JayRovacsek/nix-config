{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.pulse-eight-cec;

  # cec-client -t codes for the CEC logical device types.
  clientTypeCodes = {
    tv = 0;
    recording = 1;
    tuner = 2;
    playback = 3;
    audio-system = 4;
  };
in
{
  imports = [ ../../options/modules/pulse-eight-cec ];

  config = lib.mkIf cfg.enable {
    # The adapter exposes a CDC-ACM serial interface; grant access so
    # cec-client (and, downstream, Plasma Bigscreen's libcec integration)
    # can talk to the TV's CEC bus without privilege juggling.
    services.udev.extraRules = ''
      SUBSYSTEM=="usb", ATTRS{idVendor}=="2548", MODE="0666"
      SUBSYSTEM=="tty", ATTRS{idVendor}=="2548", MODE="0666", TAG+="uaccess"
    '';

    # libcec provides the cec-client binary used below.
    environment.systemPackages = [ pkgs.libcec ];

    environment.etc."cecc.conf".text = ''
      # Generated by modules/pulse-eight-cec - do not edit.
      autostart=1
      dev=${cfg.devicePath}
    '';

    # uinput allows CEC keypresses to be synthesised as ordinary input
    # events for the session (see htpc-software-plan.md, Requirement 5).
    hardware.uinput.enable = true;

    systemd.services.pulse-eight-cec = {
      description = "libcec daemon for the Pulse-Eight USB-CEC adapter";
      wantedBy = [ "multi-user.target" ];
      after = [ "systemd-udev-settle.service" ];
      wants = [ "systemd-udev-settle.service" ];
      serviceConfig = {
        # -d 8 runs cec-client in daemon mode, holding the adapter on the
        # CEC bus so the TV sees (and can wake/control) this host at boot.
        ExecStart = "${pkgs.libcec}/bin/cec-client -c /etc/cecc.conf -d 8 -t ${
          toString clientTypeCodes.${cfg.clientType}
        }";
        Type = "forking";
        Restart = "on-failure";
      };
    };
  };
}
