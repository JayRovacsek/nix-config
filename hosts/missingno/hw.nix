# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  config,
  lib,
  pkgs,
  ...
}:

{
  boot.initrd.availableKernelModules = [
    "nvme"
    "xhci_pci"
    "thunderbolt"
    "usbhid"
    "usb_storage"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ "amdgpu" ];
  boot.kernelModules = [
    "kvm-amd"
    "amdgpu"
  ];
  boot.extraModulePackages = [ ];

  services = {
    xserver = {
      enable = true;
      videoDrivers = [ "amdgpu" ];
    };
  };

  environment = {
    variables = {
      ROC_ENABLE_PRE_VEGA = "1";
      AMD_VULKAN_ICD = "RADV"; # Prefer RADV for better compatibility
      HSA_ENABLE_SDMA = "0"; # Prevents artifacts, improves stability for AI workloads
      HSA_OVERRIDE_GFX_VERSION = "11.5.1"; # Ensure gfx1151 is recognized
    };
    sessionVariables.LD_LIBRARY_PATH = [
      "${pkgs.rocmPackages.rocm-smi}/lib"
      "${pkgs.libdrm}/lib"
    ];
  };

  hardware.graphics = {
    enable = true;

    extraPackages = with pkgs; [
      mesa
      rocmPackages.clr
      rocmPackages.hipblas
      rocmPackages.rocblas
      rocmPackages.clr.icd
      vulkan-tools
      vulkan-loader
      vulkan-validation-layers
    ];
  };

  virtualisation.docker.enable = true;

  # https://offsite.guru/blog/halogen-strix-halo/
  boot = {
    kernelPackages = pkgs.linuxPackages_7_2;
    kernelParams = [
      "amd_iommu=off"
      "amdgpu.gttsize=126976"
      "amdgpu.vm_fragment_size=8"
      "amdgpu.vm_update_mode=0"
      "amdgpu.sg_display=0"
      "ttm.pages_limit=32505856"
      "ttm.page_pool_size=25165824"
      "amdttm.pages_limit=32505856"
    ];
  };

  hardware.enableRedistributableFirmware = true;

  environment.sessionVariables = {
    HSA_OVERRIDE_GFX_VERSION = "11.5.1";
    WLR_DRM_DEVICES = "/dev/dri/by-path/pci-0000:c3:00.0-card";
  };

  services.tuned = {
    enable = true;
    profiles = {
      strix-halo = {
        main = {
          include = "accelerator-performance";
        };
      };
    };
  };

  systemd.services.tuned-set-profile = {
    description = "Set TuneD profile";
    after = [ "tuned.service" ];
    wantedBy = [ "multi-user.target" ];
    serviceConfig = {
      Type = "oneshot";
      ExecStart = "${pkgs.tuned}/bin/tuned-adm profile accelerator-performance";
    };
  };

  environment.systemPackages = with pkgs; [
    vulkan-headers
    vulkan-tools
    vulkan-loader
    vulkan-validation-layers
    rocmPackages.rocm-smi
    rocmPackages.rocminfo
    rocmPackages.clr
  ];

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/db0e7685-6caf-437a-b2d3-fdbb0166559a";
    fsType = "ext4";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/D2C9-6220";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
